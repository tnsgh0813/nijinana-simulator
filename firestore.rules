rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 관리자 = admins/{uid} 문서가 있는 로그인 계정 (Firebase 콘솔에서 직접 만든다)
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function d() { return request.resource.data; }

    // 관리자 목록: 자기 문서만 확인 가능, 쓰기는 콘솔에서만
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // 카드 이미지 목록·썸네일 목록·홈 배너·추가 카드 데이터: 누구나 읽기, 관리자만 쓰기
    match /cardart/{doc} {
      allow read: if true;
      allow write: if isAdmin() && doc in ['map', 'thumbs', 'banners', 'notice'];
    }
    match /carddata/{doc} {
      allow read: if true;
      allow write: if isAdmin() && doc == 'custom';
    }
    // 업로드한 효과음: 오디오 형식, 1MB 미만
    match /sound/{slot} {
      allow read: if true;
      allow create, update: if isAdmin()
        && d().keys().hasOnly(['d', 't', 'n', 'at'])
        && d().d is string && d().d.size() < 1000000
        && d().t is string && d().t.matches('audio/[a-z0-9.+-]+')
        && (!('n' in d()) || (d().n is string && d().n.size() <= 60));
      allow delete: if isAdmin();
    }
    // 이미지 본문: 이미지 형식만, 1MB 미만
    match /img/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && d().keys().hasOnly(['d', 't', 's', 'at'])
        && d().d is string && d().d.size() < 1000000
        && d().t in ['image/webp', 'image/png', 'image/jpeg', 'image/gif'];
      allow delete: if isAdmin();
    }
    // 각자의 덱: 본인만 읽고 쓰기, 덱 모양·크기 제한
    match /data/users/{uid}/profile/decks/{deckId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && deckId.matches('[A-Za-z0-9_-]{1,40}')
        && d().keys().hasOnly(['name', 'ch', 'list', 'updated'])
        && d().name is string && d().name.size() <= 40
        && d().ch is string && d().ch.size() <= 20
        && d().list is map && d().list.size() <= 80
        && d().updated is number;
    }
    // 멀티 대전 방: 연결 정보만 잠깐 주고받는 곳 (게임 진행은 두 브라우저가 직접 주고받음)
    function deckOk(x) { return x is map && x.ch is string && x.ch.size() <= 20 && x.list is map && x.list.size() <= 80; }
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && code.matches('[A-Z0-9]{6}')
        && d().keys().hasOnly(['host', 'hostName', 'deck', 'offer', 'status', 'at', 'v'])
        && d().host == request.auth.uid
        && d().hostName is string && d().hostName.size() <= 40
        && deckOk(d().deck)
        && d().offer is map && d().offer.sdp is string && d().offer.sdp.size() < 20000
        && d().status == 'open';
      allow update: if request.auth != null && resource.data.host == request.auth.uid && d().host == request.auth.uid;
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;
      match /join/{doc} {
        allow read: if request.auth != null
          && (resource == null || resource.data.uid == request.auth.uid
              || get(/databases/$(database)/documents/rooms/$(code)).data.host == request.auth.uid);
        allow create: if request.auth != null && doc == 'guest'
          && exists(/databases/$(database)/documents/rooms/$(code))
          && get(/databases/$(database)/documents/rooms/$(code)).data.status == 'open'
          && get(/databases/$(database)/documents/rooms/$(code)).data.host != request.auth.uid
          && d().keys().hasOnly(['uid', 'name', 'deck', 'answer', 'at'])
          && d().uid == request.auth.uid
          && d().name is string && d().name.size() <= 40
          && deckOk(d().deck)
          && d().answer is map && d().answer.sdp is string && d().answer.sdp.size() < 20000;
        allow delete: if request.auth != null
          && (resource.data.uid == request.auth.uid
              || get(/databases/$(database)/documents/rooms/$(code)).data.host == request.auth.uid);
      }
    }
    // 그 밖의 모든 경로는 거부 (규칙에 없는 곳은 기본으로 막힘)
  }
}

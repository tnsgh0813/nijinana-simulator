rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 관리자 = admins/{uid} 문서가 있는 로그인 계정 (Firebase 콘솔에서 직접 만든다)
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // 관리자 목록: 자기 문서만 확인 가능, 쓰기는 콘솔에서만
    match /admins/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
    // 카드 이미지 목록·썸네일 목록·추가 카드 데이터: 누구나 읽기, 관리자만 쓰기
    match /cardart/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /carddata/{doc} { allow read: if true; allow write: if isAdmin(); }
    // 업로드한 효과음 (base64, 1MB 미만)
    match /sound/{slot} { allow read: if true; allow write: if isAdmin(); }
    // 이미지 본문 (base64, 1MB 미만)
    match /img/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.d is string && request.resource.data.d.size() < 1000000;
      allow delete: if isAdmin();
    }
    // 각자의 덱: 본인만 읽고 쓰기
    match /data/users/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
